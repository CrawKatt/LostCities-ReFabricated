{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "Generate cities all over the world",
  "authors": ["McJty"],
  "contact": {
    "homepage": "http://github.com/McJtyMods/LostCities/",
    "issues": "http://github.com/McJtyMods/LostCities/issues",
    "sources": "https://github.com/McJtyMods/LostCities"
  },
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "mcjty.lostcities.LostCities"
    ],
    "client": [
      "mcjty.lostcities.setup.ClientSetup"
    ],
    "fabric-datagen": [
      "mcjty.lostcities.datagen.DataGenerators"
    ]
  },
  "mixins": [
    "lostcities.mixins.json"
  ],
  "accessWidener": "META-INF/lostcities.accesswidener",
  "depends": {
    "fabricloader": ">=${fabric_loader_version}",
    "fabric-api": "*",
    "forgeconfigapiport": ">=${forge_config_api_port_version}",
    "minecraft": "${minecraft_version}",
    "java": ">=${java_version}"
  }
}
